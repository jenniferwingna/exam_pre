        {
          "label": "Purpose / reframing",
          "items": [
            {
              "t": "Free teacher time",
              "c": [],
              "d": "The objective is to release teacher time from routine preparation and marking so that it can be redirected to teaching."
            },
            {
              "t": "More individual feedback",
              "c": [],
              "d": "Every pupil should receive more frequent individual feedback than one teacher can provide on their own."
            },
            {
              "t": "Judge learning, not log-ins",
              "c": [],
              "d": "Success should be judged by teacher time and pupil learning, not by log-in rates or usage data."
            },
            {
              "t": "Data statement as precondition",
              "c": [],
              "d": "Parents' data concerns are real but more tractable, so they are treated as a condition of roll-out, not a third problem."
            }
          ]
        },
        {
          "label": "Problem 1: uneven adoption",
          "items": [
            {
              "t": "No time, no trust",
              "c": [
                "Savings miss neediest schools"
              ],
              "d": "Identical software saw use from over 70 to under 20 per cent; without protected time or trust in marking, not using it was rational."
            },
            {
              "t": "High-use schools pull ahead",
              "c": [
                "Equity gap widens"
              ],
              "d": "High-use schools give pupils more feedback and practice, so a policy meant to narrow differences between schools may widen them."
            },
            {
              "t": "Poor early usage data",
              "c": [
                "Judged failure prematurely"
              ],
              "d": "A three-year budget will show low returns on usage before educational value is tested, inviting a premature verdict of failure."
            }
          ]
        },
        {
