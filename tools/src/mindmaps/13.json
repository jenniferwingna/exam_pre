    {
      "q": 4,
      "paper": "en",
      "center": "Film Fund reform",
      "stance": "Move from grants to co-investment; ring-fence new talent",
      "branches": [
        {
          "label": "Purpose / reframing",
          "items": [
            {
              "t": "Extra investment per dollar",
              "c": [],
              "d": "Judge the Fund not by films supported but by how much additional investment, talent and audience each public dollar brings in."
            },
            {
              "t": "Not a money shortage",
              "c": [],
              "d": "Two top-ups have not changed the pattern, so the difficulty is not principally a shortage of money."
            },
            {
              "t": "Problems: terms, decisions",
              "c": [],
              "d": "The difficulty lies in the terms on which the Fund provides money and in the way it makes decisions."
            }
          ]
        },
        {
          "label": "Problem 1: Crowding out",
          "items": [
            {
              "t": "Cheap grants deter investors",
              "c": [
                "Fund depends on top-ups"
              ],
              "d": "Grants are cheaper than private money, so private funding stays near 15 per cent and a fund that recycles nothing needs top-ups."
            },
            {
              "t": "Grant-shaped projects",
              "c": [
                "Industry cannot raise finance"
              ],
              "d": "Producers learn to apply for public money rather than assemble finance and distribution, just as streaming platforms set the terms."
            },
            {
              "t": "Fund backing as signal",
              "c": [
                "Deters investors"
              ],
              "d": "The market may read Fund backing as a sign a project could not attract commercial support, deterring the investors sought."
            }
          ]
        },
        {
          "label": "Problem 2: Grant-style decisions",
          "items": [
            {
              "t": "Seven-month decisions",
              "c": [
                "Fund becomes sole financier"
              ],
              "d": "Investors work to talent and platform windows; a seven-month process lets opportunities lapse, so the Fund becomes sole financier by default."
            },
            {
              "t": "No risk-sharing rules",
              "c": [
                "Investors cannot price"
              ],
              "d": "The committee was designed to judge cultural merit, and without published risk and return rules investors cannot price participation."
            },
            {
              "t": "No outcome measures",
              "c": [
                "No value-for-money proof"
              ],
              "d": "Without outcome measures the Ministry cannot show value for money or tell a deliberate cultural investment from a failed commercial one."
            }
          ]
        },
        {
          "label": "Recommendations",
          "items": [
            {
              "t": "Co-investment, matched share",
              "c": [
                "→P1"
              ],
              "d": "Invest only alongside private investors committing a matching share of about half the budget, recycling returns; tax incentives are not recommended yet."
            },
            {
              "t": "Ring-fenced talent window",
              "c": [
                "→P1"
              ],
              "d": "A capped window keeps grants for first-time directors and cultural projects, answering the Producers' Association and protecting the talent pipeline."
            },
            {
              "t": "Independent investment committee",
              "c": [
                "→P2"
              ],
              "d": "Financiers, distributors and producers on fixed terms with conflict rules take investment decisions, replacing a committee built for grants."
            },
            {
              "t": "60-day deadline, outcome reports",
              "c": [
                "→P2"
              ],
              "d": "Publish criteria, risk-sharing terms and a 60-working-day deadline, and report private-to-public ratio, recoupment, new directors and reach annually."
            }
          ]
        },
        {
          "label": "Implementation & monitoring",
          "items": [
            {
              "t": "Rules in 6 months",
              "c": [],
              "d": "Establish investment rules and the committee within six months after consulting producers, financiers and platforms."
            },
            {
              "t": "Pilot in 12 months",
              "c": [],
              "d": "Open a co-investment pilot with a capped allocation within twelve months, alongside the talent window."
            },
            {
              "t": "Review after 3 years",
              "c": [],
              "d": "Complete a full review after three years, including whether tax incentives should be revisited, reporting indicators annually."
            },
            {
              "t": "Slow take-up: adjust share",
              "c": [],
              "d": "The main risk is slow investor response; adjust the pilot's matching share at the mid-point if take-up is weak."
            }
          ]
        }
      ]
    }
  ]
