      "q": 4,
      "paper": "en",
      "center": "Zero-carbon electricity",
      "stance": "Both routes, defined roles; manage concentration and cost",
      "branches": [
        {
          "label": "Purpose / reframing",
          "items": [
            {
              "t": "Carbon, reliability, affordability",
              "c": [],
              "d": "The objective is to decarbonise while keeping supply reliable and tariffs affordable, since failure on either would lose public support."
            },
            {
              "t": "Not rival routes",
              "c": [],
              "d": "Imports deliver zero-carbon energy in volume while local facilities provide capacity the City controls, so the two routes complement each other."
            },
            {
              "t": "Real issues: risk, payment",
              "c": [],
              "d": "The real difficulties are the risk of relying on a few large assets, and who pays, and when, under current agreements."
            }
          ]
        },
        {
          "label": "Problem 1: concentrated supply risk",
          "items": [
            {
              "t": "Few links, single failures",
              "c": [
                "Standby keeps fossil units"
              ],
              "d": "Much supply will flow through a few links and one reclaimed site; covering their loss needs standby fossil units, deferring emissions gains."
            },
            {
              "t": "30% met without projects",
              "c": [
                "Decisive projects slip silently"
              ],
              "d": "The binding 30 per cent target can likely be met without either project, so decisive ten-year projects could slip unnoticed."
            },
            {
              "t": "Major outage",
              "c": [
                "Data centres, public trust lost"
              ],
              "d": "A serious outage would make data centre operators reconsider the City and lead residents to associate decarbonisation with blackouts."
            }
          ]
        },
        {
          "label": "Problem 2: who pays, when",
          "items": [
            {
              "t": "Costs before benefits",
              "c": [
                "Regressive tariff shock"
              ],
              "d": "Capital costs reach households through tariffs before benefits arrive, hitting low-income households hardest and creating pressure to slow the programme."
            },
            {
              "t": "Return rewards building",
              "c": [
                "Incentives diverge from target"
              ],
              "d": "Fixed returns on assets reward building a local plant over buying imported power, so company interests may diverge from the cheapest path."
            },
            {
              "t": "Agreements expire in four years",
              "c": [
                "Old terms fix decade"
              ],
              "d": "If the renegotiation in four years does not realign incentives, investment plans for the decisive decade will be fixed on old terms."
            }
          ]
        },
        {
          "label": "Recommendations",
          "items": [
            {
              "t": "Defined roles, security standard",
              "c": [
                "→P1"
              ],
              "d": "Imports supply bulk energy while the local site provides firm capacity covering loss of the largest link, backed by a reserve margin and two corridors."
            },
            {
              "t": "Coal exit by milestones",
              "c": [
                "→P1"
              ],
              "d": "Coal units close as each new link or facility is commissioned and proven, so emissions fall as fast as security allows."
            },
            {
              "t": "Reward outcomes in renegotiation",
              "c": [
                "→P2"
              ],
              "d": "Make part of the permitted return depend on zero-carbon share, reliability and cost control, not on the asset base alone."
            },
            {
              "t": "Tariff path plus relief",
              "c": [
                "→P2"
              ],
              "d": "Publish projected tariffs for the decade, introduce targeted relief for low-income households with the first increase, and fund energy efficiency."
            }
          ]
        },
        {
          "label": "Implementation & monitoring",
          "items": [
            {
              "t": "Security standard in six months",
              "c": [],
              "d": "Settle the security standard and the role of the local site within six months."
            },
            {
              "t": "Imports, regulation in parallel",
              "c": [],
              "d": "Run import negotiations and the regulatory review in parallel over the next two years."
