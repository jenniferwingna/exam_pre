      "center": "AI procurement declarations",
      "stance": "Defer six months; verify, update, simplify declarations",
      "branches": [
        {
          "label": "Purpose / reframing",
          "items": [
            {
              "t": "Promise, not proof",
              "c": [],
              "d": "The requirement was meant to make vendors answerable, but a declaration on its own is a promise rather than proof."
            },
            {
              "t": "Checked, current, enforceable",
              "c": [],
              "d": "A declaration adds value only if it is checked, remains true after signing, and a false one has consequences."
            },
            {
              "t": "Extend in present form?",
              "c": [],
              "d": "The question is not whether to extend, but whether to extend a weak control that also narrows the market."
            }
          ]
        },
        {
          "label": "Problem 1: Unverified, not current",
          "items": [
            {
              "t": "38 accepted, 4 checked",
              "c": [
                "False assurance"
              ],
              "d": "Procurement staff are trained on price, not model testing; departments holding signed declarations relax their own scrutiny, creating moral hazard."
            },
            {
              "t": "Fixed at tender",
              "c": [
                "No contractual remedy"
              ],
              "d": "AI systems change after award, so a tender-date declaration gives little remedy, as the vendor's chatbot response shows."
            },
            {
              "t": "Extended Government-wide",
              "c": [
                "One incident hits all AI"
              ],
              "d": "Extension multiplies the gap, and one serious incident could undermine confidence in public-facing AI and delay sound projects."
            }
          ]
        },
        {
          "label": "Problem 2: Market narrows",
          "items": [
            {
              "t": "Bids halved, small firms out",
              "c": [
                "Less competition, lock-in"
              ],
              "d": "Bids fell from six to three and small firms' share from 45 to 20 per cent, weakening competition."
            },
            {
              "t": "Fixed compliance cost",
              "c": [
                "Local firms lose references"
              ],
              "d": "An unclear form's largely fixed cost falls hardest on small firms, undercutting the aim of giving local firms reference projects."
            },
            {
              "t": "Burden invites evasion",
              "c": [
                "Control evaded, not met"
              ],
              "d": "Departments under pressure may avoid AI procurement or describe services to fall outside the definition of public-facing AI."
            }
          ]
        },
        {
          "label": "Recommendations",
          "items": [
            {
              "t": "Tier by risk",
              "c": [
                "→P1"
              ],
              "d": "Services affecting eligibility, enforcement or vulnerable users get independent testing; information-only services need self-declaration alone."
            },
            {
              "t": "Testable, continuing declarations",
              "c": [
                "→P1"
              ],
              "d": "Replace general assurances with testable statements, treat falsity as breach, and require updates before any model change."
            },
            {
              "t": "Central assurance unit",
              "c": [
                "→P1"
              ],
              "d": "A small unit in the Ministry vets high-risk declarations and advises departments, pooling scarce expertise rather than spreading it thinly."
            },
            {
              "t": "Simpler form, free toolkit",
              "c": [
                "→P2"
              ],
              "d": "Shorten the form with worked examples, offer a free testing toolkit and brief small firms, keeping entry costs low."
            }
          ]
        },
        {
